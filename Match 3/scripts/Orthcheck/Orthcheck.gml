function Ocheck(){
var co=0;
var di=0;
var flag=false;
repeat(4)
{
	//this works???
var ic=instance_position(x+16*dcos(90*di), y+16*dsin(90*di), Fellicon)
if ic if ic.ir1==ir1&&dis!=di*90
{
co++
ic2=instance_create_depth(x,y,depth,Spark)
ic2.start=start;
start.count++;
ic2.ang=di*90;
ic2.ir1=ir1;
ic2.chain=chain+1;
if ic2.ang==ang {ic2.combo=combo+1; flag=true;} //line below is bad
//else if chain {//combo=0; 
//	//var ic3=instance_create_depth(x,y,depth,Boolet);
//	//ic3.ang=ang;
//	cast();
//	}
ic2.sprite_index=imarry[ir1];				//works

}
di++
}
if co&&flag==false&&chain cast();
if !co&&chain cast();
if !chain&&!co exit;
instance_destroy();

}